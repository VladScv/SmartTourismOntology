@prefix : <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism#> .

<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2000/01/rdf-schema#subClassOf
rdfs:subClassOf rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#equivalentClass
owl:equivalentClass rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#sameAs
owl:sameAs rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasAccessTo
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasAccessTo> rdf:type owl:ObjectProperty ;
                                                                               rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicService> ;
                                                                               rdfs:range <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TransportType> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasAttractionType
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasAttractionType> rdf:type owl:ObjectProperty ;
                                                                                     rdfs:subPropertyOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasType> ;
                                                                                     rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Attraction> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasCuisineType
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasCuisineType> rdf:type owl:ObjectProperty ;
                                                                                  rdfs:subPropertyOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasType> ;
                                                                                  rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Restaurant> ;
                                                                                  rdfs:range <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/CuisineType> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasEventType
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasEventType> rdf:type owl:ObjectProperty ;
                                                                                rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Event> ;
                                                                                rdfs:range <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/EventType> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasHotelType
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasHotelType> rdf:type owl:ObjectProperty ;
                                                                                rdfs:subPropertyOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasType> ;
                                                                                rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Hotel> ;
                                                                                rdfs:range <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/HotelType> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasQuality
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasQuality> rdf:type owl:ObjectProperty ;
                                                                              rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicService> ;
                                                                              rdfs:range <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/ServiceQuality> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasTransportType
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasTransportType> rdf:type owl:ObjectProperty ;
                                                                                    rdfs:subPropertyOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasType> ;
                                                                                    rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Transport> ;
                                                                                    rdfs:range <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TransportType> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasType
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasType> rdf:type owl:ObjectProperty ;
                                                                           rdfs:subPropertyOf owl:topObjectProperty .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/isLocatedIn
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/isLocatedIn> rdf:type owl:ObjectProperty ,
                                                                                        owl:FunctionalProperty ;
                                                                               rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicService> ;
                                                                               rdfs:range <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/City> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/nearTo
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/nearTo> rdf:type owl:ObjectProperty ,
                                                                                   owl:SymmetricProperty ;
                                                                          rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicService> ;
                                                                          rdfs:range <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicService> .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasAverageCost
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasAverageCost> rdf:type owl:DatatypeProperty ;
                                                                                  rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Transport> ;
                                                                                  rdfs:range xsd:float .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasAveragePrice
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasAveragePrice> rdf:type owl:DatatypeProperty ;
                                                                                   rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Restaurant> ;
                                                                                   rdfs:range xsd:float .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasCompany
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasCompany> rdf:type owl:DatatypeProperty ;
                                                                              rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Transport> ;
                                                                              rdfs:range xsd:string .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasDate
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasDate> rdf:type owl:DatatypeProperty ;
                                                                           rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Event> ;
                                                                           rdfs:range xsd:dateTime .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasId
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasId> rdf:type owl:DatatypeProperty ;
                                                                         rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/City> ,
                                                                                     <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicService> ;
                                                                         rdfs:range xsd:integer .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasLocation
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasLocation> rdf:type owl:DatatypeProperty ;
                                                                               rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/City> ;
                                                                               rdfs:range xsd:string .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasName
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasName> rdf:type owl:DatatypeProperty ;
                                                                           rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/City> ,
                                                                                       <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicService> ;
                                                                           rdfs:range xsd:string .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasNightPrice
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasNightPrice> rdf:type owl:DatatypeProperty ;
                                                                                 rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Hotel> ;
                                                                                 rdfs:range xsd:float .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasRating
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasRating> rdf:type owl:DatatypeProperty ;
                                                                             rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicService> ;
                                                                             rdfs:range xsd:float .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasStars
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasStars> rdf:type owl:DatatypeProperty ;
                                                                            rdfs:domain <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Hotel> ;
                                                                            rdfs:range xsd:integer .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Attraction
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Attraction> rdf:type owl:Class ;
                                                                              rdfs:subClassOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicService> ;
                                                                              rdfs:comment "Class that represents places of interest for tourists" ;
                                                                              rdfs:label "Attraction"@en ,
                                                                                         "Atracció" .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/AttractionType
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/AttractionType> rdf:type owl:Class ;
                                                                                  rdfs:subClassOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicServiceType> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/City
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/City> rdf:type owl:Class ;
                                                                        rdfs:comment "Class that represents urban locations where touristic services are located" ;
                                                                        rdfs:label "City"@en ,
                                                                                   "Ciutat"@ca ;
                                                                        owl:equivalentClass "dbo:City" .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/CuisineType
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/CuisineType> rdf:type owl:Class ;
                                                                               rdfs:subClassOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicServiceType> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/EconomicClassRestaurant
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/EconomicClassRestaurant> rdf:type owl:Class ;
                                                                                           owl:equivalentClass [ owl:intersectionOf ( <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Restaurant>
                                                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                                                        owl:onProperty <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasAveragePrice> ;
                                                                                                                                        owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                                             owl:onDatatype xsd:float ;
                                                                                                                                                             owl:withRestrictions ( [ xsd:maxInclusive "50.0"^^xsd:float
                                                                                                                                                                                    ]
                                                                                                                                                                                  )
                                                                                                                                                           ]
                                                                                                                                      ]
                                                                                                                                    ) ;
                                                                                                                 rdf:type owl:Class
                                                                                                               ] ;
                                                                                           rdfs:subClassOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Restaurant> ;
                                                                                           rdfs:comment "Budget-friendly restaurants with price under 50" ;
                                                                                           rdfs:label "Economic Class Restaurant"@en ,
                                                                                                      "Restaurant Economic"@ca .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/EconomicQuality
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/EconomicQuality> rdf:type owl:Class ;
                                                                                   rdfs:subClassOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/ServiceQuality> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Event
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Event> rdf:type owl:Class ;
                                                                         rdfs:subClassOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicService> ;
                                                                         rdfs:comment "Class that represents temporary activities of interest for tourists" ;
                                                                         rdfs:label "Event"@ca ,
                                                                                    "Event"@en .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/EventType
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/EventType> rdf:type owl:Class ;
                                                                             rdfs:subClassOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicServiceType> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/HighQuality
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/HighQuality> rdf:type owl:Class ;
                                                                               rdfs:subClassOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/ServiceQuality> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/HighQualityService
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/HighQualityService> rdf:type owl:Class ;
                                                                                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                                                                                            owl:onProperty <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasRating> ;
                                                                                                            owl:minQualifiedCardinality "45"^^xsd:nonNegativeInteger ;
                                                                                                            owl:onDataRange xsd:float
                                                                                                          ] ;
                                                                                      rdfs:subClassOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicService> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Hotel
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Hotel> rdf:type owl:Class ;
                                                                         rdfs:subClassOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicService> ;
                                                                         rdfs:comment "Class that represents accommodation services with star ratings" ;
                                                                         rdfs:label "Hotel"@ca ,
                                                                                    "Hotel"@en ;
                                                                         owl:equivalentClass "dbo:Hotel" .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/HotelType
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/HotelType> rdf:type owl:Class ;
                                                                             rdfs:subClassOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicServiceType> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/LuxuryClassRestaurant
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/LuxuryClassRestaurant> rdf:type owl:Class ;
                                                                                         owl:equivalentClass [ owl:intersectionOf ( <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Restaurant>
                                                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                                                      owl:onProperty <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasAveragePrice> ;
                                                                                                                                      owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                                           owl:onDatatype xsd:float ;
                                                                                                                                                           owl:withRestrictions ( [ xsd:minExclusive "50.0"^^xsd:float
                                                                                                                                                                                  ]
                                                                                                                                                                                )
                                                                                                                                                         ]
                                                                                                                                    ]
                                                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                                                      owl:onProperty <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasRating> ;
                                                                                                                                      owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                                           owl:onDatatype xsd:float ;
                                                                                                                                                           owl:withRestrictions ( [ xsd:minInclusive "4.0"^^xsd:float
                                                                                                                                                                                  ]
                                                                                                                                                                                )
                                                                                                                                                         ]
                                                                                                                                    ]
                                                                                                                                  ) ;
                                                                                                               rdf:type owl:Class
                                                                                                             ] ;
                                                                                         rdfs:subClassOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Restaurant> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Restaurant
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Restaurant> rdf:type owl:Class ;
                                                                              rdfs:subClassOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicService> ;
                                                                              rdfs:comment "Class that represents food establishments for tourists" ;
                                                                              rdfs:label "Restaurant"@ca ,
                                                                                         "Restaurant"@en ;
                                                                              owl:equivalentClass "<https://dbpedia.org/ontology/Restaurant>" .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/ServiceQuality
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/ServiceQuality> rdf:type owl:Class ;
                                                                                  rdfs:label "Service Quality"@en ,
                                                                                             "Type of service quality provided" ,
                                                                                             "Valoració del Servei" .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/StandardQuality
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/StandardQuality> rdf:type owl:Class ;
                                                                                   rdfs:subClassOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/ServiceQuality> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicService
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicService> rdf:type owl:Class ;
                                                                                    rdfs:comment "Class that represents all touristic services in a destination" ;
                                                                                    rdfs:label "Servei Turístic"@ca ,
                                                                                               "Touristic Service"@en .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicServiceType
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicServiceType> rdf:type owl:Class .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Transport
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Transport> rdf:type owl:Class ;
                                                                             rdfs:subClassOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicService> ;
                                                                             rdfs:comment "Class that represents transport services available in a city" ;
                                                                             rdfs:label "Transport"@ca ,
                                                                                        "Transport"@en ;
                                                                             owl:equivalentClass "<https://dbpedia.org/ontology/MeanOfTransportation>" .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TransportType
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TransportType> rdf:type owl:Class ;
                                                                                 rdfs:subClassOf <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TouristicServiceType> ;
                                                                                 rdfs:comment "Class that categorizes types of transport services" ;
                                                                                 rdfs:label "Tipus de Transport"@ca ,
                                                                                            "Transport Type"@en .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/AndalusanCuisine
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/AndalusanCuisine> rdf:type owl:NamedIndividual ,
                                                                                             <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/CuisineType> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Barcelona
