                                                                             <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasId> 4 ;
                                                                             <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasLocation> "(41.3874,2.1686)" ;
                                                                             <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/hasName> "Barcelona" ;
                                                                             rdfs:comment "City in Catalonia, Spain" ;
                                                                             rdfs:label "Barcelona"@ca ,
                                                                                        "Barcelona"@en .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/BeachAttraction
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/BeachAttraction> rdf:type owl:NamedIndividual ,
                                                                                            <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/AttractionType> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/BeachHotel
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/BeachHotel> rdf:type owl:NamedIndividual ,
                                                                                       <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/HotelType> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Bus
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/Bus> rdf:type owl:NamedIndividual ,
                                                                                <http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/TransportType> .


###  http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/BussinessHotel
<http://www.semanticweb.org/scvri/ontologies/2025/4/smart-tourism/BussinessHotel> rdf:type owl:NamedIndividual ,
